<?xml version="1.0" encoding="UTF-8"?>
<Project>
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Authors>Daniel Collingwood</Authors>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AccelerateBuildsInVisualStudio>True</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Zuemail.Core' Or '$(MSBuildProjectName)' == 'Zuemail.MailKit'">
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/danzuep/Zuemail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danzuep/Zuemail</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
  </PropertyGroup>
</Project>